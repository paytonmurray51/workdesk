# workdesk settings. Copy to .env (never commit .env) and fill in.
#   cp .env.example .env && chmod 600 .env

# Public address. Used for Google sign-in redirects and links.
WORKDESK_BASE_URL=https://workdesk.voodootechlabs.com

# Where the server listens inside the container.
WORKDESK_LISTEN_ADDR=:8080

# SQLite file inside the data volume.
WORKDESK_DB_PATH=/data/workdesk.db

# Time zone for midnight carry-over and schedules.
TZ=America/Chicago

# Google OAuth client (Web application). Redirect URI must be
#   ${WORKDESK_BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs login cookies. Generate with: openssl rand -hex 32
WORKDESK_SESSION_SECRET=

# Comma-separated emails that may sign in without an invite and become admins.
# Everyone else needs a board invite.
WORKDESK_ADMIN_EMAILS=

# Feedback button (optional). A fine-grained GitHub token with access to only the repo below
# and "Issues: Read and write". Leave empty to hide the button.
WORKDESK_FEEDBACK_GITHUB_TOKEN=
WORKDESK_FEEDBACK_REPO=paytonmurray51/workdesk

# No tunnel network setting: cloudflared on docker-host is on the default bridge network,
# so docker-compose.yml publishes 172.17.0.1:8080 and the tunnel points there.
